#
# Dolphin 26.08 forgets the Space shortcut in its open windows whenever its
# settings are applied; this notices, and offers to restart Dolphin (see
# dolphin_watch.py). With Dolphin 26.12 or later it exits at once.

[Unit]
Description=QuickView: notices when Dolphin drops the Space shortcut
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=@PYTHON@ @APPDIR@/dolphin_watch.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=graphical-session.target
