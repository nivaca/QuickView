#!/bin/sh
# QuickView — a Quick Look style file previewer for KDE Plasma.
# Copyright (C) 2026 Nicolas Vaughan <nivaca@fastmail.com>
#
# This program is free software: you can redistribute it and/or modify it
# under the terms of the GNU General Public License as published by the
# Free Software Foundation, either version 3 of the License, or (at your
# option) any later version. This program is distributed WITHOUT ANY
# WARRANTY; see the LICENSE file, or <https://www.gnu.org/licenses/>.
#
# QuickView launcher, as the package installs it.
#
# The compiled client hands the paths to the daemon — or to systemd's
# socket, which starts it — in well under a millisecond. It exits non-zero
# when nobody answered or for a flag (--settings, --daemon, --clear-cache),
# and then Python takes over: it forwards to a daemon if one is up, or
# becomes one.
CLIENT="@LIBEXECDIR@/quickview-client"
if [ $# -gt 0 ] && "$CLIENT" "$@"; then
    exit 0
fi

# Nobody answered a request for a file. Right after the package is
# installed, the socket is enabled for this user — by the package's preset
# — but not yet listening: that happens at login, and the installer, which
# runs as root and outside the session, does not reach into it. Start it
# now and send again, and systemd starts the daemon on that very request;
# without this, Python would run as a daemon systemd does not manage, and
# every preview after its idle exit would start cold until the next login.
# Not for a flag, and never a socket the user has disabled. The user's
# manager may not have read the new unit files yet, hence one reload.
case "$1" in
    -*) ;;
    "") ;;
    *)
        if command -v systemctl >/dev/null 2>&1 &&
           systemctl --user -q is-enabled quickview.socket 2>/dev/null &&
           ! systemctl --user -q is-active quickview.socket 2>/dev/null; then
            if systemctl --user start quickview.socket 2>/dev/null ||
               { systemctl --user daemon-reload 2>/dev/null &&
                 systemctl --user start quickview.socket 2>/dev/null; }; then
                "$CLIENT" "$@" && exit 0
            fi
        fi
        ;;
esac
exec /usr/bin/python3 "@DATADIR@/quickview.py" "$@"
